# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_API_BASE_URL="https://teleios-api-worker.ca88321499.workers.dev"

# WhatsApp Go Agent (local ou VPS)
AGENT_DO_URL="wss://teleios-api-worker.ca88321499.workers.dev/api/agent/ws?mode=agent"
AGENT_SECRET="3M7#kL2$vP9!xR4z"
AGENT_ID="agent_local_001"
STORE_DB_PATH="store.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# ==========================================
# GERAL
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# BANCO DE DADOS
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/teleios_db?schema=public"

# ==========================================
# SEGURANÇA & AUTENTICAÇÃO (NOVOS)
# ==========================================
JWT_SECRET=super_secret_jwt_key_para_desenvolvimento
ADMIN_INITIAL_PASSWORD=admin
CF_WORKER_SECRET=secret_para_comunicar_com_worker
RUST_GATEWAY_SECRET=secret_para_comunicar_com_rust
RUST_GATEWAY_URL=http://localhost:8000

# ==========================================
# INTEGRAÇÕES (API KEYS)
# ==========================================

# REDIS_URL: Redis queue connection for BullMQ
REDIS_URL="redis://localhost:6379"

# GOOGLE_SERVICE_ACCOUNT_KEY: Base64 or JSON string of Google Service Account for Drive and YouTube
GOOGLE_SERVICE_ACCOUNT_KEY=""

# WHASTMEO_API_URL: Whastmeo WhatsApp API endpoint running on VPS (e.g., http://vps-ip:8080 or https://api.whastmeo.com)
WHASTMEO_API_URL="http://your-vps-ip:8080"

# WHASTMEO_TOKEN: API token for Whastmeo authorization
WHASTMEO_TOKEN="your_whastmeo_bearer_token"

# YOUTUBE_CLIENT_ID & YOUTUBE_CLIENT_SECRET
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
